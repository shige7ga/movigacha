<% content_for :title, "ムビガチャ - 今日は何を観よう？" %>

<div class="max-w-xl mx-auto">
  <div class="text-center mb-10">
    <h1 class="text-4xl font-bold text-yellow-400 mb-3">今日、何の映画観る？</h1>
    <p class="text-gray-400 text-lg">ボタンを押すだけで、今日の一本が決まる</p>
  </div>

  <%= form_with url: result_path, method: :get, class: "space-y-6" do |f| %>
    <div>
      <%= f.submit "ガチャを回す",
            class: "w-full bg-yellow-400 hover:bg-yellow-300 text-gray-900 font-bold text-2xl py-5 rounded-2xl cursor-pointer transition transform hover:scale-105 shadow-xl" %>
    </div>

    <details class="bg-gray-900 rounded-2xl shadow-lg">
      <summary class="px-6 py-4 text-sm font-semibold text-gray-400 cursor-pointer select-none hover:text-gray-200 transition list-none flex items-center justify-between">
        <span>絞り込みオプション</span>
        <span class="text-xs text-gray-500">▼</span>
      </summary>

      <div class="px-6 pb-6 pt-2 space-y-5 border-t border-gray-800">
        <div>
          <label class="block text-sm font-semibold text-gray-300 mb-2">映画の分類</label>
          <%= f.select :classification,
                [["指定なし", ""], *Movie::CLASSIFICATIONS],
                {},
                class: "w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-300 mb-2">カテゴリ</label>
          <%= f.select :category,
                [["指定なし", ""], *Movie::CATEGORIES],
                {},
                class: "w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-300 mb-2">今の気分</label>
          <%= f.select :mood,
                [["指定なし", ""], *Movie::MOODS],
                {},
                class: "w-full bg-gray-800 border border-gray-700 rounded-lg px-4 py-3 text-white focus:outline-none focus:ring-2 focus:ring-yellow-400" %>
        </div>
      </div>
    </details>
  <% end %>
</div>
